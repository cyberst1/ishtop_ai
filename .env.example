# ============================================================
# ISH TOP AI — environment variables
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:replace_me
BOT_USERNAME=ish_top_ai_bot

# --- Admin ---
# Vergul bilan ajratilgan Telegram user ID lar (siznikini @userinfobot dan oling)
ADMIN_IDS=123456789

# Admin paroli — IKKI VARIANT (ikkalasi ham qo'llaniladi):
#
# (A) ENG OSON — plain text parol (tavsiya qilinadi):
ADMIN_PASSWORD=KALI_8822/*
#
# (B) BCRYPT HASH — yanada xavfsiz (ixtiyoriy):
#     python -c "import bcrypt; print(bcrypt.hashpw(b'KALI_8822/*', bcrypt.gensalt(12)).decode())"
#     ⚠️ Hashni 'single quote' ichida saqlang ($ belgilarini saqlash uchun!
ADMIN_PASSWORD_HASH=

ADMIN_SESSION_TTL_MINUTES=30

# --- AI (OpenRouter — OpenAI-compatible) ---
# https://openrouter.ai/keys  →  generatsiya qiling, "sk-or-..." bilan boshlanadi
AI_API_KEY=sk-or-v1-replace_me
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4-flash:free
# Agar asosiy model bo'sh javob bersa / sekin bo'lsa — avtomatik shu modellarga o'tadi
AI_FALLBACK_MODELS=deepseek/deepseek-v4-flash:free,meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free
# Ixtiyoriy: AI "yozmoqda" paytida ko'rsatiladigan stiker file_id
AI_TYPING_STICKER_ID=
#
# Eski NVIDIA kalitlar — agar siz NVIDIA NIM ishlatmoqchi bo'lsangiz qoldiring,
# AI_* bo'sh bo'lsa shu ishlatiladi.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# --- Database ---
DATABASE_PATH=data/ish_top_ai.db

# --- Mode ---
MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Security ---
HMAC_SECRET=generate_with_secrets.token_urlsafe_32
RATE_LIMIT_PER_MIN=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=data/logs

# --- Parsers ---
PARSER_TIMEOUT=15
PARSER_CONCURRENCY=4
JOOBLE_API_KEY=
LINKEDIN_COOKIE=

# --- Telegram channel parser ---
TG_API_ID=
TG_API_HASH=

# --- Branding ---
SUPPORT_USERNAME=cybst_academy

# --- Payment card (shown in coin purchase instructions) ---
PAYMENT_CARD_NUMBER=8600 4906 7728 0114
PAYMENT_CARD_OWNER=Cyber ST Academy
