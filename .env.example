# ============================================================
# ISH TOP AI — environment variables
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:replace_me
BOT_USERNAME=ish_top_ai_bot

# --- Admin ---
ADMIN_IDS=123456789
# python -c "import bcrypt; print(bcrypt.hashpw(b'kali_admin_8822+', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=$2b$12$replace_with_real_bcrypt_hash
ADMIN_SESSION_TTL_MINUTES=30

# --- AI ---
NVIDIA_API_KEY=nvapi-replace_me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Database ---
DATABASE_PATH=data/ish_top_ai.db

# --- Mode ---
MODE=polling
WEBHOOK_URL=https://example.com/webhook
WEBHOOK_SECRET=change_me
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Security ---
HMAC_SECRET=generate_with_secrets.token_urlsafe_32
RATE_LIMIT_PER_MIN=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=data/logs

# --- Parsers ---
PARSER_TIMEOUT=15
PARSER_CONCURRENCY=4
JOOBLE_API_KEY=
LINKEDIN_COOKIE=

# --- Telegram channel parser ---
TG_API_ID=
TG_API_HASH=
