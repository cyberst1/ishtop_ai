# ============================================================
# ISH TOP AI — environment variables
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:replace_me
BOT_USERNAME=ish_top_ai_bot

# --- Admin ---
ADMIN_IDS=123456789

# Choose ONE of the two below:
#
# (A) EASY: plain text password (recommended for non-tech users)
ADMIN_PASSWORD=kali_admin_8822+
#
# (B) ADVANCED: bcrypt hash (more secure, needs single quotes around it!)
#     Generate with:
#       python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASS', bcrypt.gensalt(12)).decode())"
#     Then store in QUOTES so the $ signs survive:
#       ADMIN_PASSWORD_HASH='$2b$12$...your_hash_here...'
ADMIN_PASSWORD_HASH=

ADMIN_SESSION_TTL_MINUTES=30

# --- AI ---
NVIDIA_API_KEY=nvapi-replace_me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Database ---
DATABASE_PATH=data/ish_top_ai.db

# --- Mode ---
MODE=polling
WEBHOOK_URL=https://example.com/webhook
WEBHOOK_SECRET=change_me
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Security ---
HMAC_SECRET=generate_with_secrets.token_urlsafe_32
RATE_LIMIT_PER_MIN=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=data/logs

# --- Parsers ---
PARSER_TIMEOUT=15
PARSER_CONCURRENCY=4
JOOBLE_API_KEY=
LINKEDIN_COOKIE=

# --- Telegram channel parser ---
TG_API_ID=
TG_API_HASH=

# --- Branding ---
SUPPORT_USERNAME=cybst_academy
