# ============================================================
# ISH TOP AI — environment variables
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:replace_me
BOT_USERNAME=ish_top_ai_bot

# --- Admin ---
# Vergul bilan ajratilgan Telegram user ID lar (siznikini @userinfobot dan oling)
ADMIN_IDS=123456789

# Admin paroli — IKKI VARIANT (ikkalasi ham qo'llaniladi):
#
# (A) ENG OSON — plain text parol (tavsiya qilinadi):
ADMIN_PASSWORD=KALI_8822/*
#
# (B) BCRYPT HASH — yanada xavfsiz (ixtiyoriy):
#     python -c "import bcrypt; print(bcrypt.hashpw(b'KALI_8822/*', bcrypt.gensalt(12)).decode())"
#     ⚠️ Hashni 'single quote' ichida saqlang ($ belgilarini saqlash uchun!
ADMIN_PASSWORD_HASH=

ADMIN_SESSION_TTL_MINUTES=30

# --- AI (NVIDIA NIM) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Database ---
DATABASE_PATH=data/ish_top_ai.db

# --- Mode ---
MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Security ---
HMAC_SECRET=generate_with_secrets.token_urlsafe_32
RATE_LIMIT_PER_MIN=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=data/logs

# --- Parsers ---
PARSER_TIMEOUT=15
PARSER_CONCURRENCY=4
JOOBLE_API_KEY=
LINKEDIN_COOKIE=

# --- Telegram channel parser ---
TG_API_ID=
TG_API_HASH=

# --- Branding ---
SUPPORT_USERNAME=cybst_academy

# --- Payment card (shown in coin purchase instructions) ---
PAYMENT_CARD_NUMBER=8600 4906 7728 0114
PAYMENT_CARD_OWNER=Cyber ST Academy
